extends ../layout

block content
  .card.col-12
    .card-header
      h1 Crear Nuevo Usuario
      a.btn.btn-ghost(href="/usuarios/vista") Volver
    form(action="/usuarios" method="POST")
      .form-group
        label Nombre del Empleado:
        input(type="text" name="nombre_empleado" required)
      .form-group
        label Email Corporativo:
        input(type="email" name="email_corporativo" required)
      button.btn.btn-primary(type="submit" style="margin-top: 20px;") Crear Usuario