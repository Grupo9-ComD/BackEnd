extends ../layout

block content
  .card.col-12
    .card-header
      h1 Crear Nuevo Envío
      a.btn.btn-ghost(href="/logistica/vista") Volver
    form(action="/logistica" method="POST")
      .form-group
        label ID Transacción:
        input(type="number" name="id_transaccion" required)
      .form-group
        label Empresa de Transporte:
        input(type="text" name="empresa_transporte" required)
      .form-group
        label Dirección de Destino:
        input(type="text" name="direccion_destino" required)
      button.btn.btn-primary(type="submit" style="margin-top: 20px;") Crear Envío