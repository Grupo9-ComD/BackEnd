extends ../layout

block content
  .card.col-12
    .card-header
      h1 Transacciones
      a.btn.btn-ghost(href="/") Volver al Panel
    table
      thead
        tr
          th ID
          th Tienda ID
          th Monto Total
          th Monto Pasarela
          th Estado Conciliación
      tbody
        each transaccion in transacciones
          tr
            td= transaccion.id
            td= transaccion.id_tienda
            td= transaccion.monto_total
            td= transaccion.monto_informado_pasarela
            td= transaccion.estado_conciliacion